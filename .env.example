DATABASE_URL=postgresql://user:password@host/database?sslmode=require
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
TELEGRAM_BOT_TOKEN=123456:ABC...
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BACKEND=api
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=sk-or-...
LLM_API_KEY=sk-or-...
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=180

# --- Langfuse (tracing + prompt management) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Метка, по которой код резолвит промпты (production | staging | ...)
LANGFUSE_PROMPT_LABEL=production
# Аварийный выключатель фетча промптов (трейсинг он не отключает)
# LANGFUSE_PROMPTS_ENABLED=false
# Переопределение имён промптов в Langfuse без правки кода
# LANGFUSE_PROMPT_NAME_INTERPRETATION=astrology_interpretation
# LANGFUSE_PROMPT_NAME_QA=astrology_qa

# --- Премиум-доступ (прогнозы по контактам и синастрия) ---
# Telegram id через запятую: доступ без правки базы. Флаг в БД
# (users.is_premium) остаётся источником истины.
# PREMIUM_TELEGRAM_IDS=123456789,987654321
